---
import {
  getMeetingSelectFilters,
  MEETING_AGENDA_OPTIONS,
  MEETING_FILTER_IDS,
  MEETING_PROTOCOL_OPTIONS,
  MEETING_TIME_RANGE_OPTIONS,
  type MeetingListVariant,
  type MeetingSelectFilterKey,
} from "../shared/meeting-filter-definitions";
import type { MeetingFilterOptions } from "../shared/types";
import FilterSelect from "./FilterSelect.astro";

interface Props {
  filterOptions: MeetingFilterOptions;
  meetingCount: number;
  variant?: MeetingListVariant;
}

const { filterOptions, meetingCount, variant = "upcoming" } = Astro.props;

type FilterOption = string | { value: string; label: string };

const optionsByKey: Record<
  MeetingSelectFilterKey,
  ReadonlyArray<FilterOption>
> = {
  organization: filterOptions.organizations,
  district: filterOptions.districts,
  timeRange: MEETING_TIME_RANGE_OPTIONS,
  month: filterOptions.months,
  agenda: MEETING_AGENDA_OPTIONS,
  protocol: MEETING_PROTOCOL_OPTIONS,
};
const selectFilters = getMeetingSelectFilters(variant);
---

{/* Same shape as the paper search toolbar (`SearchPanel`): the one filter
    most readers use stays visible as chips, the rest sit behind a "Filter"
    disclosure whose active values show as removable chips while it is closed. */}
<div class="meeting-filters" data-meeting-filters={variant}>
  <div
    class="segmented-control"
    id={MEETING_FILTER_IDS.bodyType}
    role="group"
    aria-label="Gremientyp"
  >
    <button
      type="button"
      class="segmented-control-option active"
      data-meeting-body-type-option
      data-value=""
      aria-pressed="true"
    >
      Alle
    </button>
    {filterOptions.bodyTypes.map((bodyType) => (
      <button
        type="button"
        class="segmented-control-option"
        data-meeting-body-type-option
        data-value={bodyType}
        aria-pressed="false"
      >
        {bodyType}
      </button>
    ))}
  </div>

  <div class="meeting-toolbar">
    <button
      type="button"
      class="meeting-filter-toggle"
      aria-expanded="false"
      aria-controls="meeting-filter-panel"
      data-meeting-filter-toggle
    >
      Filter
      <span
        class="meeting-filter-count"
        aria-hidden="true"
        data-meeting-filter-count
        hidden
      ></span>
    </button>
    <div
      class="meeting-active-filters"
      role="group"
      aria-label="Aktive Filter"
      data-meeting-active-filters
    ></div>
    <p
      class="meeting-filter-status"
      data-meeting-filter-status
      aria-live="polite"
    >
      {meetingCount} Sitzungen
    </p>
  </div>

  <div
    class="meeting-filter-panel"
    id="meeting-filter-panel"
    data-meeting-filter-panel
    hidden
  >
    <div class="meeting-filter-fields">
      {selectFilters.map(({ key, id, label, emptyLabel }) => (
        <FilterSelect
          id={id}
          label={label}
          emptyLabel={emptyLabel}
          options={optionsByKey[key]}
        />
      ))}
      <div class="filter-group meeting-search-filter">
        <label for={MEETING_FILTER_IDS.search}>Suche</label>
        <input
          id={MEETING_FILTER_IDS.search}
          type="search"
          placeholder="Titel oder Ort"
          autocomplete="off"
        />
      </div>
    </div>
    <div class="meeting-filter-footer">
      <button
        type="button"
        class="meeting-filter-reset"
        id={MEETING_FILTER_IDS.reset}
        data-meeting-filter-reset
      >
        Zurücksetzen
      </button>
    </div>
  </div>
</div>

<script>
  import { initMeetingFilters } from "../shared/meeting-filter-controller";

  initMeetingFilters();
</script>

<style>
  .meeting-filters {
    display: grid;
    gap: 10px;
    margin: 0 0 20px;
  }

  .meeting-filters [hidden] {
    display: none !important;
  }

  .segmented-control {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .segmented-control-option {
    min-height: 34px;
    padding: 5px 12px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    font-family: var(--font-family);
    font-size: 0.86rem;
    cursor: pointer;
    background: #fff;
  }

  .segmented-control-option:hover {
    border-color: var(--color-link);
    color: var(--color-link);
  }

  .segmented-control-option[aria-pressed="true"] {
    border-color: var(--color-link);
    color: #fff;
    background: var(--color-link);
  }

  .meeting-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .meeting-filter-toggle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 34px;
    padding: 5px 13px 5px 12px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: #fff;
    color: var(--color-text);
    font-family: var(--font-family);
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
  }

  .meeting-filter-toggle::before {
    content: "";
    width: 6px;
    height: 6px;
    margin: -2px 2px 0 0;
    border-right: 1.5px solid;
    border-bottom: 1.5px solid;
    transform: rotate(45deg);
  }

  .meeting-filter-toggle[aria-expanded="true"] {
    background: var(--color-bg-card);
  }

  .meeting-filter-toggle[aria-expanded="true"]::before {
    margin-top: 3px;
    transform: rotate(-135deg);
  }

  .meeting-filter-toggle:hover {
    border-color: var(--color-text-muted);
  }

  .meeting-filter-count {
    display: inline-grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--color-link);
    color: #fff;
    font-size: 0.7rem;
    line-height: 1;
  }

  .meeting-active-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    min-width: 0;
  }

  .meeting-active-filters:empty {
    display: none;
  }

  .meeting-active-filters :global(button) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    max-width: 100%;
    min-height: 30px;
    padding: 4px 11px;
    border: 1px solid color-mix(in srgb, var(--color-link) 25%, #fff);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-link) 8%, #fff);
    color: var(--color-link-hover);
    font-family: var(--font-family);
    font-size: 0.78rem;
    text-align: left;
    overflow-wrap: anywhere;
    cursor: pointer;
  }

  .meeting-active-filters :global(button:hover) {
    background: color-mix(in srgb, var(--color-link) 15%, #fff);
  }

  .meeting-active-filters :global(.chip-remove) {
    font-size: 1rem;
    line-height: 1;
  }

  .meeting-filter-status {
    margin: 0 0 0 auto;
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }

  .meeting-filter-panel {
    padding: 16px 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-card);
  }

  .meeting-filter-fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 14px 18px;
  }

  .meeting-filter-fields :global(.filter-group) {
    min-width: 0;
    max-width: none;
  }

  /* Same label and field as `FilterSelect`. */
  .meeting-search-filter label {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .meeting-search-filter input {
    width: 100%;
    min-height: 38px;
    box-sizing: border-box;
    padding: 7px 10px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text);
    font-size: 0.88rem;
    background: #fff;
  }

  .meeting-filter-footer {
    display: flex;
    justify-content: flex-end;
    margin-top: 14px;
    padding-top: 10px;
    border-top: 1px solid var(--color-border);
  }

  .meeting-filter-reset {
    min-height: 32px;
    padding: 4px 0;
    border: 0;
    background: none;
    color: var(--color-text-muted);
    font-family: var(--font-family);
    font-size: 0.8rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  @media screen and (max-width: 540px) {
    .meeting-active-filters {
      order: 3;
      flex-basis: 100%;
    }

    /* 16px keeps iOS Safari from zooming the page when a control gets focus. */
    .meeting-filter-fields :global(select),
    .meeting-search-filter input {
      font-size: 16px;
    }

    .meeting-filter-panel {
      padding: 14px;
    }
  }
</style>
