---
import type {
  Organization,
  Paper,
  ResolvedPaperSubmitter,
} from "../shared/types";
import {
  buildDistrictUrl,
  buildFactionUrl,
  formatDateShort,
} from "../shared/utils";
import {
  isBulkImportTimestamp,
  PLACEHOLDER_OFFICES,
} from "../shared/paper-presentation";

interface Props {
  paper: Paper;
  organizations: Organization[];
  submitters: ResolvedPaperSubmitter[];
}

const { paper, organizations, submitters } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;

/** Search result cards read these as Pagefind meta — keep the names in sync
 * with `search-panel-controller.ts`. Type and date carry their meta in
 * `PaperHeader.astro`; the rows here are `data-pagefind-ignore`. */
const pagefindModifiedSortAtt = `modified:${new Date(paper.modified).toISOString()}`;

const organizationNames = organizations
  .map((organization) => organization?.name)
  .filter((name) => name && !PLACEHOLDER_OFFICES.has(name))
  .join(", ");
const paperDate = formatDateShort(paper.date);
/* The bulk import stamped most papers with the same day; printing it as
   "Letzte Änderung" would claim an edit nobody made. */
const showModified = !isBulkImportTimestamp(paper.modified);

/* Districts and factions each have a list page of their own, so every value
   here doubles as the entry point to "what else came from this corner of the
   city". Pagefind reads the `dd` text, which the links leave unchanged.
   `href` is optional: factions hidden in `data.ts` have no page. */
const linkedFacts: {
  term: string;
  meta: string;
  links: { name: string; href?: string }[];
}[] = [
  {
    term: `Antragstellende Fraktion${submitters.length === 1 ? "" : "en"}`,
    meta: "paper-submitters",
    links: submitters.map(({ factionId, name }) => ({
      name,
      href: factionId ? buildFactionUrl(baseUrl, factionId) : undefined,
    })),
  },
  {
    term: "Erwähnte Stadtteile",
    meta: "paper-districts",
    links: paper.stadtteile.map((name) => ({
      name,
      href: buildDistrictUrl(baseUrl, name),
    })),
  },
].filter(({ links }) => links.length > 0);
---

<section class="section-card" aria-labelledby="paper-facts">
  <h2 class="section-heading" id="paper-facts">
    Eckdaten
  </h2>

  {/* Only facts the paper has: a row of "Keine Angaben" answers nothing. */}
  <dl class="facts">
    {/* The paper's primary identifier, and the only place it appears as page
        text — so this is what makes a search for "2025/0152" resolve. The
        breadcrumb shows it too but is `data-pagefind-ignore`. */}
    <dt>Vorlagen-Nr.</dt>
    <dd class="fact-reference" data-pagefind-meta="paper-reference">
      {paper.reference}
    </dd>

    {/* Date and type are filters, not search terms: ignored so that every
        "Antrag" page does not match a search for "Antrag" on this label. Their
        Pagefind meta stays on the empty spans in `PaperHeader`. */}
    {paper.paperType && (
      <Fragment>
        <dt data-pagefind-ignore>Art</dt>
        <dd data-pagefind-ignore>{paper.paperType}</dd>
      </Fragment>
    )}
    {paperDate && (
      <Fragment>
        <dt data-pagefind-ignore>Datum</dt>
        <dd data-pagefind-ignore>
          <time datetime={paper.date}>{paperDate}</time>
        </dd>
      </Fragment>
    )}

    {showModified && (
      <Fragment>
        <dt>Letzte Änderung</dt>
        <dd>
          <time
            datetime={paper.modified}
            data-pagefind-meta="paper-modified[datetime]"
            data-pagefind-sort={pagefindModifiedSortAtt}
          >
            {formatDateShort(paper.modified)}
          </time>
        </dd>
      </Fragment>
    )}

    {organizationNames && (
      <Fragment>
        <dt>Unter Leitung von</dt>
        <dd data-pagefind-meta="paper-organizations">{organizationNames}</dd>
      </Fragment>
    )}

    {linkedFacts.map(({ term, meta, links }) => (
      <Fragment>
        <dt>{term}</dt>
        <dd data-pagefind-meta={meta}>
          <ul class="fact-links">
            {links.map(({ name, href }) => (
              <li>{href ? <a href={href}>{name}</a> : <span>{name}</span>}</li>
            ))}
          </ul>
        </dd>
      </Fragment>
    ))}
  </dl>

  {/* Literal meta values — no visible text, no excerpt. `paper-modified`
      and its sort key ride here when the date is the import stamp, so result
      cards and the "changed" sort still see it (they treat it as a fallback). */}
  <span data-pagefind-meta={`paper-created:${paper.created}`}></span>
  {!showModified && (
    <span
      data-pagefind-meta={`paper-modified:${paper.modified}`}
      data-pagefind-sort={pagefindModifiedSortAtt}
    ></span>
  )}
</section>

<style>
  .facts {
    margin: 0;
    display: grid;
    gap: 12px;
  }

  dt {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  dd {
    margin: 3px 0 0;
    line-height: 1.5;
  }

  .fact-reference {
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  /* Chips rather than a comma list: the values are links now, and adjacent
     underlined names run together at this size. */
  .fact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fact-links a,
  .fact-links span {
    display: inline-block;
    padding: 3px 10px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg-card);
    color: var(--color-link);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .fact-links span {
    color: var(--color-text-muted);
  }

  .fact-links a:hover {
    border-color: var(--color-link);
    background: #fff;
    text-decoration: underline;
  }
</style>
