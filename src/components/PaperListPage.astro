---
import PageContainer from "./PageContainer.astro";
import SearchPanel from "./SearchPanel.astro";
import type { SearchState } from "../shared/search-state";

interface Props {
  scope?: Partial<SearchState>;
  title: string;
}

const { title, scope } = Astro.props;
---

<PageContainer>
  {/* Above the title, as on every detail page. */}
  <slot name="breadcrumbs" />
  <h1 class="page-header">{title}</h1>
  <slot name="intro" />
  <div data-pagefind-ignore>
    <SearchPanel scope={scope} />
  </div>
</PageContainer>
