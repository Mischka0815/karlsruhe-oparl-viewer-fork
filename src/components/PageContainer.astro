---
interface Props {
  class?: string;
  /**
   * `narrow` keeps long-form pages at a readable measure; `medium` fits the
   * meeting pages' date-led rows; `search` is a single column, such as a search
   * box above its result list.
   *
   * Set the width here rather than with a `max-width` on a passed `class`: a
   * page's scoped styles never reach this component's element.
   */
  width?: "wide" | "narrow" | "medium" | "search";
}

const { class: className, width = "wide" } = Astro.props;
---

<div class:list={["page-container", `width-${width}`, className]}>
  <slot />
</div>

<style>
  .page-container {
    margin: 0 auto;
  }

  .width-wide {
    max-width: 1400px;
  }

  .width-narrow {
    max-width: 1120px;
  }

  .width-medium {
    max-width: 1000px;
  }

  .width-search {
    max-width: 900px;
  }
</style>
