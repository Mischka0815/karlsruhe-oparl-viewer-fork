---
import { buildMeetingCalendarFeedUrl } from "../shared/utils";

/**
 * Subscribe links for the meeting calendar feed. `webcal://` opens the
 * subscription dialog in Apple Calendar and Outlook; Google Calendar needs its
 * own link; the plain URL is there to paste into anything else.
 */
const feedPath = buildMeetingCalendarFeedUrl(import.meta.env.BASE_URL);
const feedUrl = Astro.site ? new URL(feedPath, Astro.site).href : feedPath;
const webcalUrl = feedUrl.replace(/^https?:\/\//, "webcal://");
const googleUrl = `https://calendar.google.com/calendar/r?cid=${encodeURIComponent(webcalUrl)}`;
---

{/* One visible action. Google and the raw address are for fewer readers, so
    they open from a small disclosure instead of taking two more rows above
    the meeting list. */}
<div class="calendar-subscription">
  <a class="calendar-subscribe" href={webcalUrl}>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <rect x="3" y="5" width="18" height="16" rx="2"></rect>
      <path d="M16 3v4M8 3v4M3 10h18M12 13v5M9.5 15.5h5"></path>
    </svg>
    Kalender abonnieren
  </a>
  <details class="calendar-more" data-calendar-more>
    <summary>Andere Kalender-Apps</summary>
    <div class="calendar-more-panel">
      <a href={googleUrl} target="_blank" rel="noopener noreferrer">
        In Google Kalender öffnen
        <span class="visually-hidden"> (öffnet in neuem Tab)</span>
      </a>
      <div class="calendar-url">
        <label for="calendar-feed-url">Adresse zum Einfügen</label>
        <div class="calendar-url-row">
          <input
            id="calendar-feed-url"
            type="url"
            value={feedUrl}
            readonly
            data-calendar-feed-url
          />
          <button type="button" data-calendar-copy hidden>
            Kopieren
          </button>
        </div>
      </div>
    </div>
  </details>
</div>

<script>
  document.querySelectorAll(".calendar-subscription").forEach((container) => {
    const input = container.querySelector<HTMLInputElement>(
      "[data-calendar-feed-url]",
    );
    const button = container.querySelector<HTMLButtonElement>(
      "[data-calendar-copy]",
    );
    if (!input || !button) return;

    const more = container.querySelector<HTMLDetailsElement>(
      "[data-calendar-more]",
    );
    if (more) {
      // The panel floats over the list, so it closes the way a menu does.
      document.addEventListener("click", (event) => {
        if (more.open && !more.contains(event.target as Node)) {
          more.open = false;
        }
      });
      more.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !more.open) return;
        more.open = false;
        more.querySelector("summary")?.focus();
      });
    }

    input.addEventListener("focus", () => input.select());
    if (!navigator.clipboard) return;

    button.hidden = false;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(input.value);
        button.textContent = "Kopiert";
      } catch {
        input.select();
        button.textContent = "Bitte manuell kopieren";
      }
    });
  });
</script>

<style>
  .calendar-subscription {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
  }

  .calendar-subscribe {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    width: fit-content;
    padding: 8px 12px;
    border: 1px solid var(--color-primary-hover);
    border-radius: var(--radius);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .calendar-subscribe:hover {
    background: var(--color-primary-hover);
  }

  .calendar-subscribe svg {
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .calendar-more {
    position: relative;
  }

  .calendar-more summary {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--color-link);
    font-size: 0.86rem;
    cursor: pointer;
    list-style: none;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .calendar-more summary::-webkit-details-marker {
    display: none;
  }

  /* It opens a panel below, so the same down caret as the "Filter" toggles. */
  .calendar-more summary::after {
    content: "";
    width: 6px;
    height: 6px;
    margin-top: -3px;
    border-right: 1.5px solid;
    border-bottom: 1.5px solid;
    transform: rotate(45deg);
  }

  .calendar-more[open] summary::after {
    margin-top: 3px;
    transform: rotate(-135deg);
  }

  .calendar-more-panel {
    position: absolute;
    z-index: 20;
    top: calc(100% + 8px);
    left: 0;
    display: grid;
    gap: 12px;
    width: min(26rem, calc(100vw - 32px));
    padding: 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
    box-shadow: var(--shadow-card);
  }

  /* On phones the summary may sit anywhere in the row; anchor to the right
     edge so the panel never runs off-screen. */
  @media screen and (max-width: 540px) {
    .calendar-more {
      position: static;
    }

    .calendar-subscription {
      position: relative;
    }

    .calendar-more-panel {
      left: 0;
      right: 0;
      width: auto;
    }
  }

  .calendar-more-panel a {
    color: var(--color-link);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .calendar-url label {
    display: block;
    margin-bottom: 4px;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .calendar-url-row {
    display: flex;
    gap: 8px;
  }

  .calendar-url input {
    flex: 1;
    min-width: 0;
    padding: 7px 10px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
    font: inherit;
    font-size: 0.85rem;
  }

  .calendar-url button {
    flex-shrink: 0;
    padding: 7px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
    color: var(--color-link);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
  }

  .calendar-url button:hover {
    background: var(--color-bg-hover);
  }
</style>
