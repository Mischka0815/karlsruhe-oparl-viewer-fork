---
interface Props {
  id: string;
  label: string;
  options: ReadonlyArray<string | { value: string; label: string }>;
  emptyLabel?: string;
  /** Short explanation shown under the select and linked as its description. */
  hint?: string;
}

const { id, label, options, emptyLabel = "Alle", hint } = Astro.props;

const normalizedOptions = options.map((option) =>
  typeof option === "string" ? { value: option, label: option } : option,
);
---

<div class="filter-group">
  <label for={id}>{label}</label>
  <select id={id} aria-describedby={hint ? `${id}-hint` : undefined}>
    <option value="">{emptyLabel}</option>
    {normalizedOptions.map(({ value, label: optionLabel }) => (
      <option value={value}>{optionLabel}</option>
    ))}
  </select>
  {hint && (
    <p class="filter-hint" id={`${id}-hint`}>
      {hint}
    </p>
  )}
</div>

<style>
  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: 1 1 146px;
    min-width: 140px;
    max-width: 210px;
  }

  .filter-group label {
    display: block;
    font-size: 0.72rem;
    line-height: 1.1;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .filter-group select {
    width: 100%;
    min-height: 34px;
    padding: 4px 10px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 0.86rem;
    line-height: 1.2;
    font-family: var(--font-family);
    color: var(--color-text);
    background: #fff;
    cursor: pointer;
  }

  .filter-hint {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .filter-group select:focus {
    outline: 2px solid var(--color-link);
    outline-offset: 1px;
  }

  @media screen and (max-width: 768px) {
    .filter-group {
      flex: 1 1 136px;
      min-width: 124px;
      max-width: none;
    }
  }
</style>
