---
// PT Sans is the styleguide's body face. Self-hosted (no request to a font
// CDN) and only the Latin subset, which covers German.
import "@fontsource/pt-sans/latin-400.css";
import "@fontsource/pt-sans/latin-400-italic.css";
import "@fontsource/pt-sans/latin-700.css";
import SiteNavigation from "../components/SiteNavigation.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHint from "../components/SiteHint.astro";
import type { NavigationSection } from "../shared/navigation";
import { buildCanonicalUrl, truncateForMetaDescription } from "../shared/seo";

interface Props {
  title?: string;
  description?: string;
  pagefindIgnore?: boolean;
  navigationSection?: NavigationSection;
  /** Keep the page out of search indexes (client-only or duplicate views). */
  noindex?: boolean;
  /** JSON-LD emitted as-is into a `application/ld+json` script tag. */
  structuredData?: Record<string, unknown>;
  /** Let `SiteHint` scan the page text and show the hint for AfD mentions. */
  siteHintScan?: boolean;
  /** Show the `SiteHint` even if it was dismissed (e.g. AfD submissions). */
  siteHintForce?: boolean;
}

const {
  title,
  description,
  pagefindIgnore = false,
  navigationSection,
  noindex = false,
  structuredData,
  siteHintScan = false,
  siteHintForce = false,
} = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const pageTitle = title ? `${title} | GemeinderatsRadar` : "GemeinderatsRadar";
const SITE_DESCRIPTION =
  "Vorlagen, Sitzungen und Tagesordnungspunkte des Karlsruher Gemeinderats \u2013 durchsuchbar, verlinkt und t\u00e4glich aktualisiert.";
const metaDescription = truncateForMetaDescription(
  description ?? SITE_DESCRIPTION,
);
const canonicalUrl = buildCanonicalUrl(Astro.url, Astro.site);
---

<!doctype html>
<html lang="de" data-pagefind-ignore={pagefindIgnore ? "all" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link
      rel="sitemap"
      type="application/xml"
      href={`${baseUrl}sitemap-index.xml`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GemeinderatsRadar" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {/* X/Twitter falls back to the og:* tags, so only the card type is worth
    the ~300 bytes it costs on each of the ~30k pages. */}
    <meta name="twitter:card" content="summary" />
    {structuredData && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Zum Inhalt springen
    </a>
    <SiteNavigation currentSection={navigationSection} />
    <main
      id="main-content"
      data-site-hint-scan={siteHintScan || undefined}
      data-site-hint-force={siteHintForce || undefined}
    >
      <slot />
    </main>
    <SiteFooter />
    <SiteHint />
  </body>
</html>

<style is:global>
  /* Colors and type follow the GRÜNE styleguide (September 2023): Tanne is
     the primary color, Sand the light ground, Sonne the highlight. Text and
     links use Tanne (9:1 on white); Klee only just clears 4.5:1 and Himmel
     fails it, so Klee is kept for hover and focus and Himmel is unused. */
  :root {
    --gruene-tanne: #005437;
    --gruene-klee: #008939;
    --gruene-grashalm: #8abd24;
    --gruene-sand: #f5f1e9;
    --gruene-himmel: #0ba1dd;
    --gruene-sonne: #fff17a;

    --color-primary: var(--gruene-tanne);
    --color-primary-hover: #003d28;
    --color-on-primary: var(--gruene-sand);
    --color-link: var(--gruene-tanne);
    --color-link-hover: var(--gruene-klee);
    --color-highlight: var(--gruene-sonne);
    --color-text: #1f2a24;
    --color-text-muted: #4f5a54;
    --color-border: #ddd6c8;
    --color-bg-card: var(--gruene-sand);
    --color-bg-hover: #faf8f3;
    --color-focus: var(--gruene-klee);
    --color-danger: #b10000;
    --color-success: #176b3a;
    --color-success-bg: #e8f5ec;
    --color-info: var(--gruene-tanne);
    --color-info-bg: #e3efe8;
    --shadow-card: 0 4px 6px rgba(0, 0, 0, 0.1);
    --radius: 8px;
    --font-family: "PT Sans", Arial, sans-serif;
    /* The sticky site header's height. Anything that sticks or scrolls into
       view below it has to clear this, so it lives here rather than in
       `SiteNavigation.astro`, which only consumes it. */
    --site-header-height: 68px;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    margin: 0;
    padding: 0;
    color: var(--color-text);
    background: #fff;
    font-family: var(--font-family);
  }

  button,
  input,
  select,
  textarea {
    font-family: inherit;
  }

  /* The one focus ring for the whole site — components do not restyle it. */
  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  select:focus-visible,
  summary:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  .skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 2000;
    padding: 10px 14px;
    border-radius: var(--radius);
    background: #171717;
    color: #fff;
    font-family: var(--font-family);
    font-weight: 700;
    text-decoration: none;
    transform: translateY(-160%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .page-header {
    /* Scales down on phones, where a fixed 2.5rem single-word title like
       "GemeinderatsRadar" is wider than the viewport. */
    font-size: clamp(1.75rem, 1.25rem + 2.5vw, 2.5rem);
    line-height: 1.2;
    color: var(--color-primary);
    margin-bottom: 20px;
    font-family: var(--font-family);
    font-weight: bold;
    text-align: center;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  /* Cards stack five or six deep on the detail pages — the only place they
     are used — so the rhythm is kept tight. */
  .section-card {
    margin-top: 14px;
    padding: 16px 18px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .section-heading {
    margin: 0 0 10px;
    font-size: 1.35rem;
    font-weight: bold;
    color: var(--color-primary);
  }

  /* Title block shared by the paper and meeting detail pages: left aligned,
     capped at a readable measure, closed by the brand rule. Unlike the
     centred `.page-header`, these titles are often full sentences. */
  .detail-header {
    padding-bottom: 14px;
    border-bottom: 3px solid var(--color-primary);
  }

  .detail-title {
    max-width: 62ch;
    margin: 0;
    font-size: clamp(1.5rem, 1.1rem + 1.5vw, 2.05rem);
    font-weight: bold;
    line-height: 1.2;
    text-wrap: balance;
  }

  /* "Nothing here" lines: no results, nothing published, search unavailable. */
  .empty-state {
    margin: 24px 0;
    padding: 14px 16px;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
    text-align: center;
  }
</style>

<style>
  main {
    flex: 1;
    width: 100%;
    box-sizing: border-box;
    padding: 20px;
    font-family: var(--font-family);
  }
</style>
