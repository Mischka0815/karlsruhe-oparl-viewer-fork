---
import Layout from "../layouts/Layout.astro";
import PageContainer from "../components/PageContainer.astro";
import StadtteilHint from "../components/StadtteilHint.astro";
import {
  getAvailableDistricts,
  getOrtschaften,
  getPaperCountsByDistrict,
} from "../shared/data";
import { getDistrictOrtschaft } from "../shared/meeting-presentation";
import { buildDistrictUrl } from "../shared/utils";

const [districtNames, paperCountsByDistrict, ortschaften] = await Promise.all([
  getAvailableDistricts(),
  getPaperCountsByDistrict(),
  getOrtschaften(),
]);

const baseUrl = import.meta.env.BASE_URL;
---

<Layout
  title="Stadtteile"
  description="Karlsruher Stadtteile mit den Vorlagen und Ortschaftsrats-Themen, die sie betreffen."
  pagefindIgnore
  navigationSection="districts"
>
  <PageContainer class="stadtteile-page">
    <h1 class="page-header">Vorlagen nach Stadtteil</h1>
    <p class="subtitle">{districtNames.length} Stadtteile mit Vorlagen</p>
    <StadtteilHint />
    <div class="stadtteile-grid">
      {districtNames.map((districtName) => (
        <a
          href={buildDistrictUrl(baseUrl, districtName)}
          class="stadtteil-card"
        >
          <span class="stadtteil-name">{districtName}</span>
          <span class="stadtteil-count">
            {paperCountsByDistrict.get(districtName) ?? 0} Vorlagen
          </span>
          {/* Ortschaften have their own council, whose sittings the district
              page links to. */}
          {getDistrictOrtschaft(districtName, ortschaften.all) && (
            <span class="stadtteil-kind">Ortschaft</span>
          )}
        </a>
      ))}
    </div>
  </PageContainer>
</Layout>

<style>
  .subtitle {
    text-align: center;
    color: var(--color-text-muted);
    margin-bottom: 14px;
  }

  .stadtteile-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }

  .stadtteil-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 20px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    transition:
      box-shadow 0.2s,
      transform 0.2s;
  }

  .stadtteil-card:hover {
    box-shadow: var(--shadow-card);
    transform: translateY(-2px);
  }

  .stadtteil-name {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .stadtteil-kind {
    width: fit-content;
    margin-top: 2px;
    padding: 0 7px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    font-size: 0.72rem;
  }

  .stadtteil-count {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  /* Two columns on phones: 28 full-width cards were three screens of
     scrolling for a list of names. */
  @media screen and (max-width: 768px) {
    .stadtteile-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .stadtteil-card {
      padding: 12px 14px;
    }

    .stadtteil-name {
      font-size: 1rem;
      hyphens: auto;
    }
  }
</style>
