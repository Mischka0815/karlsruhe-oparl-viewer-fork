---
import { getPaperDetailStaticPaths } from "../../shared/paper-detail-paths";
import Layout from "../../layouts/Layout.astro";
import PaperListPage from "../../components/PaperListPage.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import {
  getAvailablePaperSubmitters,
  loadPaperSubmitters,
} from "../../shared/data";
import { getOParlEntityId } from "../../shared/utils";

export async function getStaticPaths() {
  const submitters = await getAvailablePaperSubmitters();
  return submitters.map((submitter) => ({
    params: { name: submitter.id },
    props: { submitterId: submitter.id, submitterName: submitter.name },
  }));
}

const { submitterId, submitterName } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const [allPapers, submitterIndex] = await Promise.all([
  getPaperDetailStaticPaths().then((paths) =>
    paths.map((path) => path.props.paper),
  ),
  loadPaperSubmitters(),
]);

const papersBySubmitter = allPapers.filter((paper) => {
  const recordId = getOParlEntityId(paper.id);
  return recordId && submitterIndex.papers[recordId]?.includes(submitterId);
});

const papers = papersBySubmitter;
---

<Layout
  title={submitterName}
  description={`Alle ${papers.length} Vorlagen und Anträge von ${submitterName} im Karlsruher Gemeinderat, mit Volltextsuche und Filtern.`}
  navigationSection="submitters"
>
  <PaperListPage scope={{ faction: submitterId }} title={submitterName}>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: "Fraktionen", href: `${baseUrl}fraktionen` },
        { label: submitterName },
      ]}
    />
  </PaperListPage>
</Layout>
