---
import { getPaperDetailStaticPaths } from "../../shared/paper-detail-paths";
import Layout from "../../layouts/Layout.astro";
import PaperListPage from "../../components/PaperListPage.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import StadtteilHint from "../../components/StadtteilHint.astro";
import FeedSubscriptionLink from "../../components/FeedSubscriptionLink.astro";
import {
  getAvailableDistricts,
  getOrtschaften,
  loadSyndicationFeedCatalog,
} from "../../shared/data";
import { getDistrictOrtschaft } from "../../shared/meeting-presentation";
import { buildOrtschaftMeetingsUrl, slugify } from "../../shared/utils";

export async function getStaticPaths() {
  const districtNames = await getAvailableDistricts();
  return districtNames.map((districtName) => ({
    params: { name: slugify(districtName) },
    props: { districtName },
  }));
}

const { districtName } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;

const allPapers = (await getPaperDetailStaticPaths()).map(
  (path) => path.props.paper,
);
const feedCatalog = await loadSyndicationFeedCatalog();
const districtPapers = allPapers.filter((paper) =>
  paper.stadtteile.includes(districtName),
);
const districtFeed = feedCatalog.districtFeedByName.get(districtName);
const ortschaften = await getOrtschaften();
const ortschaft = getDistrictOrtschaft(
  districtName,
  ortschaften.withUpcomingMeetings,
);

const papers = districtPapers;
---

<Layout
  title={districtName}
  description={`Vorlagen des Karlsruher Gemeinderats mit Bezug zum Stadtteil ${districtName} – ${papers.length} Einträge, mit Volltextsuche und Filtern.`}
  navigationSection="districts"
>
  <PaperListPage scope={{ district: districtName }} title={districtName}>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: "Stadtteile", href: `${baseUrl}stadtteile` },
        { label: districtName },
      ]}
    />
    {/* The paper count lives in the search toolbar; the row keeps only what
        leads elsewhere. */}
    <div slot="intro">
      {(districtFeed || ortschaft) && (
        <p class="district-links" data-pagefind-ignore>
          {ortschaft && (
            <a href={buildOrtschaftMeetingsUrl(baseUrl, ortschaft)}>
              Sitzungen des Ortschaftsrats {ortschaft}
            </a>
          )}
          {districtFeed && (
            <FeedSubscriptionLink
              href={districtFeed.url}
              label="Aktualisierungen abonnieren"
              compact
            />
          )}
        </p>
      )}
      <StadtteilHint />
    </div>
  </PaperListPage>
</Layout>

<style>
  .district-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 18px;
    margin: -6px 0 10px;
    font-size: 0.88rem;
  }

  /* Same treatment as the feed link beside it. */
  .district-links > a {
    color: var(--color-link);
    text-decoration: none;
  }

  .district-links > a:hover {
    text-decoration: underline;
  }
</style>
