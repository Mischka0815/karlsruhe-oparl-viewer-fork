---
import Layout from "../../layouts/Layout.astro";
import PageContainer from "../../components/PageContainer.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import MeetingAgenda from "../../components/MeetingAgenda.astro";
import MeetingActions from "../../components/MeetingActions.astro";
import MeetingDigest from "../../components/MeetingDigest.astro";
import {
  loadSyndicationFeedCatalog,
  resolveMeetingAgenda,
  resolveMeetingDigestLeads,
  resolveMeetingOrganizations,
} from "../../shared/data";
import { getMeetingStaticPaths } from "../../shared/meeting-paths";
import {
  formatDateLong,
  formatDateTime,
  getEffectiveMeetingEnd,
  hasPublishedMeetingEnd,
  getOParlEntityId,
  normalizeOParlUrl,
} from "../../shared/utils";
import {
  buildMeetingArchiveUrl,
  buildMeetingArchiveYearUrl,
  getMeetingYear,
} from "../../shared/meeting-archive";
import {
  formatMeetingDayAndTime,
  formatMeetingName,
  getUnnamedOrganizations,
} from "../../shared/meeting-presentation";
import type { AuxiliaryFile, Meeting } from "../../shared/types";
import { buildMeetingDescription } from "../../shared/seo";

export async function getStaticPaths() {
  return getMeetingStaticPaths();
}

interface Props {
  meeting: Meeting;
}

const { meeting } = Astro.props;
const [agenda, organizations, feedCatalog, digestLeads] = await Promise.all([
  resolveMeetingAgenda(meeting),
  resolveMeetingOrganizations(meeting),
  loadSyndicationFeedCatalog(),
  resolveMeetingDigestLeads(meeting),
]);
const baseUrl = import.meta.env.BASE_URL;
const meetingId = getOParlEntityId(meeting.id);
const meetingName = formatMeetingName(meeting.name);
const committeeFeeds = organizations.flatMap((organization) => {
  const feed = feedCatalog.committeeFeedByOrganizationId.get(organization.id);
  return feed ? [{ name: organization.name, url: feed.url }] : [];
});
/**
 * Past meetings lead back into the archive year they belong to; upcoming ones
 * back to the list they are still on. Evaluated at build time, so a meeting
 * changes sides with the next deploy.
 */
const isPastMeeting =
  getEffectiveMeetingEnd(meeting.start, meeting.end) < new Date();
const meetingYear = getMeetingYear(meeting.start);
const breadcrumbItems = [
  { label: "Sitzungen", href: `${baseUrl}sitzungen` },
  ...(isPastMeeting && meetingYear
    ? [
        { label: "Archiv", href: buildMeetingArchiveUrl(baseUrl) },
        {
          label: meetingYear,
          href: buildMeetingArchiveYearUrl(baseUrl, meetingYear),
        },
      ]
    : []),
  { label: meetingName },
];
const hasPublishedEnd = hasPublishedMeetingEnd(meeting.start, meeting.end);
/** "3. November 2026 um 18:30–20:30 Uhr"; an end on a later day is spelled out. */
const endsSameDay =
  hasPublishedEnd &&
  formatDateLong(meeting.start) === formatDateLong(meeting.end);
const meetingSlot = !hasPublishedEnd
  ? `${formatDateTime(meeting.start)} Uhr`
  : endsSameDay
    ? `${formatDateTime(meeting.start)}–${formatMeetingDayAndTime(meeting.end).time} Uhr`
    : `${formatDateTime(meeting.start)} Uhr bis ${formatDateTime(meeting.end)} Uhr`;
const organizationNames = organizations.map(
  (organization) => organization.name,
);
/* The committee row only earns its place when the title does not already
   name it — "Sozialausschuss" under "Sozialausschuss" says nothing. */
const showOrganizations =
  organizationNames.length === 0 ||
  getUnnamedOrganizations(meetingName, organizationNames).length > 0;
const rawDocuments: { label: string; file: AuxiliaryFile }[] = [
  meeting.invitation && { label: "Einladung", file: meeting.invitation },
  meeting.resultsProtocol && {
    label: "Ergebnisprotokoll",
    file: meeting.resultsProtocol,
  },
  meeting.verbatimProtocol && {
    label: "Wortprotokoll",
    file: meeting.verbatimProtocol,
  },
  ...(meeting.auxiliaryFile ?? []).map((file) => ({
    label: "Unterlage",
    file,
  })),
].filter((entry): entry is { label: string; file: AuxiliaryFile } =>
  Boolean(entry),
);
const seenDocumentIds = new Set<string>();
const documents = rawDocuments.filter(({ file }) => {
  if (seenDocumentIds.has(file.id)) return false;
  seenDocumentIds.add(file.id);
  return true;
});
const metaDescription = buildMeetingDescription({
  name: meetingName,
  start: meeting.start,
  agendaItemCount: agenda.length,
});
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: meetingName,
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  ...(meeting.start ? { startDate: meeting.start } : {}),
  ...(hasPublishedEnd ? { endDate: meeting.end } : {}),
  ...(meeting.location?.description
    ? {
        location: {
          "@type": "Place",
          name: meeting.location.description,
        },
      }
    : {}),
  organizer: {
    "@type": "GovernmentOrganization",
    name: organizations[0]?.name ?? "Gemeinderat Karlsruhe",
  },
  inLanguage: "de",
};
---

<Layout
  title={meetingName}
  description={metaDescription}
  structuredData={structuredData}
  pagefindIgnore
  navigationSection="meetings"
>
  <PageContainer width="medium">
    <Breadcrumbs items={breadcrumbItems} />
    <header class="detail-header">
      <h1 class="detail-title">{meetingName}</h1>
    </header>

    <section class="section-card meeting-key-info" data-pagefind-ignore>
      <dl>
        <div>
          <dt>Termin</dt>
          <dd>
            <time datetime={meeting.start}>{meetingSlot}</time>
          </dd>
        </div>
        <div>
          <dt>Ort</dt>
          <dd>
            {meeting.location?.description || "Noch nicht veröffentlicht"}
          </dd>
        </div>
        {showOrganizations && (
          <div>
            <dt>Gremium</dt>
            <dd>{organizationNames.join(", ") || "Keine Angabe"}</dd>
          </div>
        )}
      </dl>
      <MeetingActions meetingId={meetingId} committeeFeeds={committeeFeeds} />
    </section>

    <MeetingDigest
      meetingId={meetingId}
      knownLeads={digestLeads}
      isPast={isPastMeeting}
    />

    <MeetingAgenda items={agenda} isPast={isPastMeeting} />

    {documents.length > 0 && (
      <section class="section-card" data-pagefind-ignore>
        <h2 class="section-heading">Sitzungsunterlagen</h2>
        <ul class="document-list">
          {documents.map(({ label, file }) => (
            <li>
              <a
                href={normalizeOParlUrl(file.accessUrl)}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>{file.name}</span>
                <small>{label}</small>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </PageContainer>
</Layout>

<style>
  .meeting-key-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  dl {
    display: grid;
    gap: 10px;
    margin: 0;
  }

  dl div {
    display: grid;
    grid-template-columns: 90px 1fr;
    align-items: baseline;
    gap: 10px;
  }

  /* Same label style as the paper page's "Eckdaten". */
  dt {
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    line-height: 1.5;
  }

  /* One bordered list of rows, like the related papers on the paper page. */
  .document-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .document-list li + li {
    border-top: 1px solid var(--color-border);
  }

  .document-list a {
    display: grid;
    gap: 2px;
    padding: 10px 12px;
    color: var(--color-link);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .document-list a:hover {
    background: var(--color-bg-hover);
  }

  .document-list a:hover span {
    text-decoration: underline;
  }

  .document-list small {
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }

  @media screen and (max-width: 650px) {
    .meeting-key-info {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
