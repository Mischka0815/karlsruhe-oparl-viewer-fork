{
  "name": "karlsruhe-oparl-viewer",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "predev": "node scripts/ensure-pagefind-index.mjs",
    "dev": "astro dev",
    "data:setup": "node scripts/setup-local-data.mjs",
    "data:people": "node scripts/fetch-oparl-people.mjs",
    "prestart": "node scripts/ensure-pagefind-index.mjs",
    "start": "astro dev",
    "build": "astro build",
    "build:quick": "SKIP_PAGEFIND=1 astro build",
    "build:quiet": "node scripts/build-quiet.mjs",
    "build:quick:quiet": "SKIP_PAGEFIND=1 node scripts/build-quiet.mjs",
    "build:verify": "node scripts/verify-build-output.mjs",
    "test": "node --test tests/",
    "test:search-index": "node scripts/verify-search-index.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "format": "npx prettier . --write"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/pt-sans": "^5.3.0",
    "astro": "^7.4.4",
    "pagefind": "^1.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2"
  }
}
